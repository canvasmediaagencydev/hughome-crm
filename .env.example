# =============================================================================
# HugHome CRM — Pilot instance environment (Phase 1)
# =============================================================================
# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง (อย่า commit .env.local)
#   cp .env.example .env.local
#
# ทุกตัวที่ไม่ได้ระบุว่า (optional) = จำเป็น ถ้าขาด app จะ fail ตอนรัน
# พร้อมบอกชื่อตัวแปรที่ขาด (ดู src/config/env.ts) — ไม่มี fallback เงียบๆ
#
# ⚠️ pilot ต้องใช้ค่าของ "ระบบใหม่" เท่านั้น ห้ามใส่ค่าของ production แม่ริมเดิม
# =============================================================================

# --- Supabase --------------------------------------------------------------
# Supabase Dashboard → Project Settings → Data API / API Keys
# URL หน้าตา https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — server เท่านั้น ห้ามหลุดเข้า client bundle
SUPABASE_SERVICE_ROLE_KEY=

# --- LINE ------------------------------------------------------------------
# LINE Developers Console → Provider (ใหม่) → LINE Login channel → LIFF
# LIFF ID หน้าตา 2000xxxxxx-xxxxxxxx
NEXT_PUBLIC_LINE_LIFF_ID=
# LINE Login channel → Basic settings → Channel ID (ใช้ verify JWKS aud, Sprint 2)
LINE_CHANNEL_ID=
# Messaging API channel → Channel access token (สำหรับ push แจ้งเตือนลูกค้า)
LINE_CHANNEL_ACCESS_TOKEN=

# --- Tenant (สาขา) — MIGRATION_PLAN.md §3.1 --------------------------------
# code: pilot | mae_rim | fa_ham
NEXT_PUBLIC_TENANT_CODE=pilot
# ชื่อสาขาที่แสดงผล เช่น ฟ้าฮ่าม
NEXT_PUBLIC_TENANT_NAME=
# segment: B2B | B2C
NEXT_PUBLIC_TENANT_SEGMENT=
# เบอร์โทรร้าน (แสดงหน้า /call)
NEXT_PUBLIC_TENANT_PHONE=
# LINE OA id / basic id ของสาขา (เช่น @xxxxxxx)
NEXT_PUBLIC_TENANT_LINE_OA=
# URL เพจ Facebook ของสาขา (ขึ้นต้น http/https)
NEXT_PUBLIC_TENANT_FB_URL=

# --- Cron ------------------------------------------------------------------
# secret สำหรับป้องกัน endpoint /api/cron/* (ตั้งค่าเดียวกันใน Vercel Cron header)
CRON_SECRET=

# --- Session ---------------------------------------------------------------
# คีย์เซ็น session cookie (HS256) — สร้างเอง: openssl rand -hex 32
SESSION_SECRET=

# --- Optional / future -----------------------------------------------------
# OCR เป็น Non-Goal (MIGRATION_PLAN.md §13) — server-side เท่านั้น ห้าม NEXT_PUBLIC_
# Google AI Studio → API key
GEMINI_API_KEY=
# เปิด/ปิด LINE push ('true' เพื่อเปิด) — ปล่อยว่าง = ปิด
NOTIFICATIONS_ENABLED=

# --- Sprint 8: แจ้งทีมเข้า Telegram / LINE group ---------------------------
# คีย์เข้ารหัส Telegram bot token ที่เก็บใน DB (AES-256-GCM) — 64 hex, สร้าง: openssl rand -hex 32
# ไม่ตั้ง = เพิ่ม/ส่ง channel แบบ telegram ไม่ได้ (throw ทันที ไม่มี fallback) · line_group ไม่ต้องใช้
# ⚠️ เปลี่ยนคีย์แล้ว token เก่าใน DB จะถอดไม่ได้ ต้องกรอกใหม่ทุก channel
NOTIFY_TOKEN_KEY=
