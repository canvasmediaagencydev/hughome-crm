  "columns": [
    { "key": "customer_code",  "header": "รหัสลูกค้า",       "letter": "A", "required": true,  "type": "text",   "width": 14 },
    { "key": "purchase_date",  "header": "วันที่ซื้อ",      "letter": "B", "required": true,  "type": "date",   "width": 13 },
    { "key": "bill_no",        "header": "เลขที่บิล",       "letter": "C", "required": true,  "type": "text",   "width": 18 },
    { "key": "phone",          "header": "เบอร์โทรลูกค้า",   "letter": "D", "required": true,  "type": "text",   "width": 16 },
    { "key": "customer_name",  "header": "ชื่อลูกค้า",       "letter": "E", "required": false, "type": "text",   "width": 26 },
    { "key": "gross",          "header": "ยอดซื้อ",         "letter": "F", "required": true,  "type": "number", "width": 12 },
    { "key": "discount",       "header": "ยอดลดหนี้",       "letter": "G", "required": false, "type": "number", "width": 12 },
    { "key": "sales_rep",      "header": "Maker",           "letter": "H", "required": true,  "type": "list",   "width": 28 },
    { "key": "note",           "header": "หมายเหตุ",        "letter": "I", "required": false, "type": "text",   "width": 30 }
